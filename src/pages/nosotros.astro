---
import PlantillaBase from '@plantillas/PlantillaBase.astro';
import Boton from '@componentes/comunes/Boton.astro';
import { Image } from 'astro:assets';

import nosotrosHeroImg from '@assets/images/Nosotros/Hero.webp';
import organizacionSimpleImg from '@assets/images/Nosotros/familia.webp';
import iconoCercania from '@assets/images/Iconos/cercania.webp';
import iconoColaboracion from '@assets/images/Iconos/colaboracion.webp';
import iconoAcompanamiento from '@assets/images/Iconos/acompanamiento.webp';
import iconoMemoria from '@assets/images/Iconos/memoria.webp';
import iconoChats from '@assets/images/Iconos/chats.webp';
import iconoEventos from '@assets/images/Iconos/eventos.webp';
import iconoRecordatorios from '@assets/images/Iconos/campana.webp';
import iconoCompras from '@assets/images/Iconos/compras.webp';
---

<PlantillaBase 
  titulo="Nosotros - Historia y Propósito"
  descripcion="Conoce la historia, visión y valores de Kivana: crear una forma más simple de vivir la organización familiar."
  rutaActual="/nosotros"
>
  <!-- HERO -->
  <section class="seccion hero-nosotros">
    <div class="contenedor grid-dos-columnas">
      <div class="bloque-texto">
        <h2 class="hero__titulo">Una forma más simple de vivir la organización familiar</h2>
        <p class="hero__descripcion">
          Kivana nace para ayudar a las familias a coordinarse, motivar a los niños y conservar los momentos que importan en la vida cotidiana.
        </p>
        <div class="hero__acciones">
          <Boton href="/funcionalidades" variante="primario">
            Conoce Kivana
          </Boton>
        </div>
      </div>
      <div class="bloque-visual">
        <Image 
          src={nosotrosHeroImg} 
          alt="Ilustración de la familia Kivana" 
          class="bloque-visual__imagen"
          width={480}
          height={480}
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- EL PROBLEMA VS LA IDEA -->
  <section class="seccion seccion--blanca">
    <div class="contenedor">
      <div class="grid-dos-columnas margin-top-xl">
        <div class="bloque-texto">
          <h2 class="bloque-texto__titulo">¿Y si todo viviera en un solo lugar?</h2>
          <p class="bloque-texto__descripcion">
            La vida familiar se organiza entre mensajes, calendarios, recordatorios, tareas y momentos que queremos conservar. Kivana nace de una idea sencilla: reunir lo importante en un solo lugar y hacer que cada miembro pueda participar.
          </p>
          <p class="bloque-texto__descripcion">
            Queremos que organizar la familia no sea solamente administrar pendientes. También significa construir hábitos, acompañar a los niños y guardar las experiencias que hacen especial la vida cotidiana.
          </p>
        </div>
        <div class="bloque-visual">
          <Image 
            src={organizacionSimpleImg} 
            alt="Organización familiar simple e integrada" 
            class="bloque-visual__imagen"
            width={460}
            height={460}
            loading="lazy"
          />
        </div>
      </div>
      <div class="grid-iconos-dispersos">
        <div class="icono-item">
          <Image src={iconoChats} alt="Chats" width={60} height={60} loading="lazy" />
          <span>Chats</span>
        </div>
        <div class="icono-item">
          <Image src={iconoEventos} alt="Eventos" width={60} height={60} loading="lazy" />
          <span>Eventos</span>
        </div>
        <div class="icono-item">
          <Image src={iconoRecordatorios} alt="Recordatorios" width={60} height={60} loading="lazy" />
          <span>Recordatorios</span>
        </div>
        <div class="icono-item">
          <Image src={iconoCompras} alt="Compras" width={60} height={60} loading="lazy" />
          <span>Compras</span>
        </div>
      </div>

    </div>
  </section>

  <!-- FRASE DE PROPÓSITO -->
  <section class="seccion seccion--proposito">
    <div class="contenedor texto-centrado">
      <blockquote class="proposito-quote">
        "Kivana organiza lo importante y convierte cada responsabilidad en un logro.
"
      </blockquote>
    </div>
  </section>

  <!-- NUESTROS VALORES -->
  <section class="seccion seccion--blanca">
    <div class="contenedor texto-centrado">
      <h2 class="seccion__titulo">Nuestros Valores</h2>
      <p class="seccion__subtitulo">Los principios que guían nuestra forma de diseñar para la familia.</p>

      <div class="grid-cuatro-valores">
        <article class="valor-card">
          <Image src={iconoCercania} alt="Icono Cercanía" class="valor-card__icono" width={80} height={80} loading="lazy" />
          <h3 class="valor-card__titulo">Cercanía</h3>
          <p class="valor-card__descripcion">Una herramienta pensada para la vida cotidiana real de los hogares.</p>
        </article>

        <article class="valor-card">
          <Image src={iconoColaboracion} alt="Icono Colaboración" class="valor-card__icono" width={80} height={80} loading="lazy" />
          <h3 class="valor-card__titulo">Colaboración</h3>
          <p class="valor-card__descripcion">Cada integrante de la familia puede participar y sentirse tomado en cuenta.</p>
        </article>

        <article class="valor-card">
          <Image src={iconoAcompanamiento} alt="Icono Acompañamiento" class="valor-card__icono" width={80} height={80} loading="lazy" />
          <h3 class="valor-card__titulo">Acompañamiento</h3>
          <p class="valor-card__descripcion">Motivar e incentivar el crecimiento sin prometer un control absoluto.</p>
        </article>

        <article class="valor-card">
          <Image src={iconoMemoria} alt="Icono Memoria" class="valor-card__icono" width={80} height={80} loading="lazy" />
          <h3 class="valor-card__titulo">Memoria</h3>
          <p class="valor-card__descripcion">Organizar lo que viene para disfrutar y conservar lo vivido juntos.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="seccion cta-final">
    <div class="contenedor cta-final__contenedor">
      <h2 class="cta-final__titulo">Construyamos juntos la organización familiar.</h2>
      <p class="cta-final__descripcion">
        Únete a las familias que ya organizan lo que importa de manera cercana y colaborativa.
      </p>
      <div class="cta-final__acciones">
        <Boton href="/funcionalidades" variante="menta">
          Conoce Kivana
        </Boton>
        <Boton href="/contacto" variante="blanco">
          Contáctanos
        </Boton>
      </div>
    </div>
  </section>
</PlantillaBase>

<style>
  .badge-nosotros {
    display: inline-block;
    font-family: var(--font-cuerpo);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-azul);
    background-color: var(--color-amarillo);
    padding: 0.35rem 1rem;
    border-radius: var(--radius-full);
    margin-bottom: 1.25rem;
  }

  .grid-dos-columnas {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .grid-dos-columnas {
      grid-template-columns: 1fr 1fr;
    }
  }

  .bloque-visual__imagen {
    width: 100%;
    max-width: 460px;
    height: auto;
    margin-left: auto;
    margin-right: auto;
  }

  .seccion--blanca {
    background-color: var(--color-blanco);
  }

  /* Grid Iconos Dispersos */
  .grid-iconos-dispersos {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 2.5rem;
    padding: 1.5rem;
    /*background-color: var(--color-crema);
    */
    border-radius: var(--radius-md);
  }

  .icono-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 200px;
    padding: 10px;
    border-radius: 20px;
    border: 2px solid var(--color-menta);
    gap: 0.5rem;
    font-family: var(--font-titulos);
    font-weight: 600;
    color: var(--color-menta);
  }

  .margin-top-xl {
    margin-top: 3rem;
  }

  /* Sección Propósito Quote */
  .seccion--proposito {
    background-color: var(--color-coral);
    color: var(--color-azul);
    padding-top: 4rem;
    padding-bottom: 4rem;
  }

  .proposito-quote {
    font-family: var(--fuente-titulos);
    font-size: clamp(1.4rem, 2.5vw, 2.1rem);
    font-weight: 400;
    line-height: 1.4;
    max-width: 840px;
    margin-left: auto;
    margin-right: auto;
    border: none;
    color: var(--color-crema);
  }

  /* Grid Valores */
  .grid-cuatro-valores {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-top: 2.5rem;
  }

  @media (min-width: 768px) {
    .grid-cuatro-valores {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .grid-cuatro-valores {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .valor-card {
    background-color: var(--color-crema);
    padding: 2rem 1.25rem;
    border-radius: var(--radius-md);
    box-shadow: var(--sombra-suave);
    text-align: center;
    transition: transform 0.25s ease;
  }

  .valor-card:hover {
    transform: translateY(-4px);
  }

  .valor-card__icono {
    width: 80px;
    height: auto;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 1rem;
  }

  .valor-card__titulo {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
  }

  .valor-card__descripcion {
    font-size: 0.95rem;
    line-height: 1.5;
  }

  /* CTA Final */
  .cta-final {
    background-color: #FFF9F0;
    border: 2px solid #DDF0EA;
    color: #123B56;
    text-align: center;
    border-radius: var(--radio-lg);
    margin: 3rem 1.5rem;
    box-shadow: 0 10px 30px rgba(107, 173, 153, 0.12);
  }

  .cta-final__titulo {
    color: #123B56;
    margin-bottom: 1rem;
  }

  .cta-final__descripcion {
    color: #123B56;
    font-size: 1.2rem;
    max-width: 540px;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 2rem;
  }

  .cta-final__acciones {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hero-nosotros .hero__titulo {
    margin-bottom: 1.5rem;
  }

  .hero-nosotros .hero__descripcion {
    margin-bottom: 2.25rem;
  }

  .hero-nosotros .hero__acciones {
    margin-top: 1.5rem;
  }

  @media (max-width: 767px) {
    .hero-nosotros .bloque-texto,
    .bloque-texto {
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .hero-nosotros .hero__acciones,
    .cta-final__acciones {
      justify-content: center;
    }
  }
</style>
