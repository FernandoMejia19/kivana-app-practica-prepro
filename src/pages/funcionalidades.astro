---
import PlantillaBase from '@plantillas/PlantillaBase.astro';
import Boton from '@componentes/comunes/Boton.astro';
import { Image } from 'astro:assets';

import heroFuncImg from '@assets/images/Funcionalidades/Funcionalidades-hero.webp';
import eventosImg from '@assets/images/Funcionalidades/calendario.webp';
import tareasImg from '@assets/images/Funcionalidades/Funcionalidades-actividad.webp';
import familiaImg from '@assets/images/Funcionalidades/Funcionalidades-familia.webp';
import AppImagen from '@assets/images/Funcionalidades/actividades.webp';
---

<PlantillaBase 
  titulo="Funcionalidades"
  descripcion="Eventos, tareas y recuerdos relevantes, reunidos en una sola vista para que toda la familia tenga claridad."
  rutaActual="/funcionalidades"
>
  <!-- HERO  -->
  <section class="seccion hero-funcionalidades">
    <div class="contenedor grid-dos-columnas">
      <div class="bloque-texto">
        <h2 class="hero__titulo">Todo lo importante de tu familia, conectado.</h2>
        <p class="hero__descripcion">
          Eventos, tareas y recuerdos relevantes, reunidos en una sola vista para que toda la familia tenga claridad.
        </p>
      </div>
      <div class="bloque-visual">
        <Image 
          src={heroFuncImg} 
          alt="Vista general de las funcionalidades conectadas en Kivana" 
          class="bloque-visual__imagen"
          width={500}
          height={500}
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- MÓDULO 1: INICIO -->
  <section class="seccion seccion--blanca">
    <div class="contenedor grid-dos-columnas grid-dos-columnas--reverso">
      <div class="bloque-texto">
        <h2 class="bloque-texto__titulo">Empieza el día sabiendo qué toca.</h2>
        <p class="bloque-texto__descripcion">
          Un resumen familiar claro con los próximos eventos, las tareas pendientes del hogar y los recuerdos del día.
        </p>
        <div class="lista-detalles-eventos">
          <div class="detalle-item">
            <h3 class="detalle-item__titulo resaltar-coral">•  Organiza</h3>
            <p class="detalle-item__descripcion">Fecha y hora en un solo lugar.</p>
          </div>
          <div class="detalle-item">
            <h3 class="detalle-item__titulo resaltar-coral">•  Participa</h3>
            <p class="detalle-item__descripcion">Sabe quién está invitado.</p>
          </div>
          <div class="detalle-item">
            <h3 class="detalle-item__titulo resaltar-coral">•  Ubica</h3>
            <p class="detalle-item__descripcion">Añade el lugar del evento.</p>
          </div>
        </div>
      </div>
      <div class="bloque-visual">
        <Image 
          src={eventosImg} 
          alt="Calendario de eventos con asignaciones por hora" 
          class="bloque-visual__imagen"
          width={440}
          height={440}
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- MÓDULO 2 Y 3 UNIFICADO: TAREAS Y FAMILIA (FILAS HORIZONTALES UNIFICADAS) -->
  <section class="seccion seccion-filas-unificadas">
    <div class="contenedor contenedor-filas-unificadas">
      <article class="fila-unificada">
        <div class="fila-unificada__visual">
          <Image 
            src={tareasImg} 
            alt="Módulo de tareas asignadas con prioridades" 
            class="fila-unificada__imagen"
            width={300}
            height={300}
            loading="lazy"
          />
        </div>
        <div class="fila-unificada__texto">
          <h2 class="fila-unificada__titulo">Todos saben qué hacer hoy.</h2>
          <p class="fila-unificada__descripcion">
            Asigna tareas, define prioridades y mantén las responsabilidades del hogar claras para todos.
          </p>
        </div>
      </article>

      <article class="fila-unificada fila-unificada--reversa">
        <div class="fila-unificada__texto">
          <h2 class="fila-unificada__titulo">La familia también es un equipo.</h2>
          <p class="fila-unificada__descripcion">
            Crea tu espacio familiar, invita a sus integrantes y decide quién puede formar parte de él.
          </p>
        </div>
        <div class="fila-unificada__visual">
          <Image 
            src={familiaImg} 
            alt="Integrantes del grupo familiar participando en equipo" 
            class="fila-unificada__imagen"
            width={300}
            height={300}
            loading="lazy"
          />
        </div>
      </article>
    </div>
  </section>

  <!-- MÓDULO 4: RECUERDOS -->
  <section class="seccion seccion--crema-oscura">
    <div class="contenedor texto-centrado">
      <h2 class="seccion__titulo">Guarda lo vivido, no solo organizarlo.</h2>
      <p class="seccion__subtitulo">
        Fotos, videos y momentos especiales para conservar los recuerdos más importantes de la familia.
      </p>
      <div class="galeria-grid">
        <article class="galeria-card">
          <Image src={AppImagen} alt="Galería Kivana" class="galeria-card__imagen" width={320} height={320} loading="lazy" />
          <h3 class="galeria-card__titulo">Captura 1</h3>
        </article>
        <article class="galeria-card">
          <Image src={AppImagen} alt="Galería Kivana" class="galeria-card__imagen" width={320} height={320} loading="lazy" />
          <h3 class="galeria-card__titulo">Captura 2</h3>
        </article>
        <article class="galeria-card">
          <Image src={AppImagen} alt="Galería Kivana" class="galeria-card__imagen" width={320} height={320} loading="lazy" />
          <h3 class="galeria-card__titulo">Captura 3</h3>
        </article>
      </div>
    </div>
  </section>
  <!-- CTA FINAL -->
  <section class="seccion cta-final">
    <div class="contenedor cta-final__contenedor">
      <h2 class="cta-final__titulo">Todo lo importante, conectado.</h2>
      <p class="cta-final__descripcion">
        Una experiencia pensada para que toda la familia tenga claridad.
      </p>
      <div class="cta-final__acciones">
        <Boton href="/contacto" variante="azul">
          Conoce Kivana
        </Boton>
        <Boton href="/contacto" variante="blanco">
          Contactar
        </Boton>
      </div>
    </div>
  </section>
</PlantillaBase>

<style>
  .hero-funcionalidades {
    background-color: var(--color-crema);
  }

  .hero__titulo {
    margin-bottom: 1.5rem;
  }

  .hero__descripcion {
    font-size: 1.15rem;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .badge-modulo, .badge-submodulo {
    display: inline-block;
    font-family: var(--fuente-cuerpo);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-azul);
    background-color: var(--color-amarillo);
    padding: 0.35rem 1rem;
    border-radius: var(--radio-completo);
    margin-bottom: 1.25rem;
  }

  .badge-submodulo {
    background-color: var(--color-menta);
    color: var(--color-blanco);
  }

  .grid-dos-columnas {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .grid-dos-columnas {
      grid-template-columns: 1fr 1fr;
    }

    .grid-dos-columnas--reverso .bloque-texto {
      order: 2;
    }

    .grid-dos-columnas--reverso .bloque-visual {
      order: 1;
    }
  }

  .bloque-visual__imagen {
    width: 100%;
    max-width: 460px;
    height: auto;
    margin-left: auto;
    margin-right: auto;
  }

  .seccion--blanca {
    background-color: var(--color-blanco);
  }

  .lista-detalles-eventos {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .detalle-item {
    padding: rem 1.25rem;
    border-radius: var(--radio-sm);
  }

  .detalle-item__titulo {
    font-size: 1.1rem;
    color: var(--color-azul);
    margin-bottom: 0.25rem;
  }

  .detalle-item__descripcion {
    font-size: 0.95rem;
  }

  /* Filas Unificadas Horizontalmente (Tareas + Familia) */
  .seccion-filas-unificadas {
    padding-top: 1.5rem;
    padding-bottom: 2rem;
  }

  .contenedor-filas-unificadas {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .fila-unificada {
    background-color: var(--color-blanco);
    border-radius: var(--radio-md);
    padding: 1.5rem 2rem;
    box-shadow: var(--sombra-suave);
    border: 1px solid rgba(var(--color-azul-rgb), 0.05);
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: center;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .fila-unificada:hover {
    transform: translateY(-3px);
    box-shadow: var(--sombra-media);
  }

  @media (min-width: 768px) {
    .fila-unificada {
      grid-template-columns: 0.75fr 1.25fr;
      padding: 1.5rem 2.5rem;
    }

    .fila-unificada--reversa {
      grid-template-columns: 1.25fr 0.75fr;
    }
  }

  .fila-unificada__visual {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .fila-unificada__imagen {
    width: 100%;
    max-width: 250px;
    height: auto;
    object-fit: contain;
  }

  .fila-unificada__texto {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .fila-unificada__titulo {
    font-size: 1.35rem;
    color: var(--color-azul);
    margin: 0;
  }

  .fila-unificada__descripcion {
    font-size: 0.95rem;
    line-height: 1.5;
    color: rgba(var(--color-azul-rgb), 0.85);
    margin: 0;
  }

  .seccion--crema-oscura {
    background-color: rgba(var(--color-amarillo-rgb), 0.12);
  }

  .seccion--crema-oscura .seccion__titulo {
    margin-bottom: 1.25rem;
  }

  .seccion--crema-oscura .seccion__subtitulo {
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 3.5rem;
    line-height: 1.6;
  }

  .galeria-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-top: 1rem;
  }

  @media (min-width: 768px) {
    .galeria-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .galeria-card {
    background-color: var(--color-blanco);
    padding: 1.5rem;
    border-radius: var(--radio-md);
    box-shadow: var(--sombra-suave);
    transition: transform 0.25s ease;
  }

  .galeria-card:hover {
    transform: translateY(-4px);
  }

  .galeria-card__imagen {
    width: 100%;
    height: auto;
    border-radius: var(--radio-sm);
    margin-bottom: 1rem;
  }

  .galeria-card__titulo {
    font-size: 1.2rem;
  }

  .cta-final {
    background-color: #DDF0EA;
    color: #123B56;
    text-align: center;
    border-radius: var(--radio-lg);
    margin: 3rem 1.5rem;
  }

  .cta-final__titulo {
    color: #123B56;
    margin-bottom: 1rem;
  }

  .cta-final__descripcion {
    color: #123B56;
    font-size: 1.2rem;
    max-width: 540px;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 2rem;
  }

  .cta-final__acciones {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  @media (max-width: 767px) {
    .hero-funcionalidades .bloque-texto,
    .bloque-texto {
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
  }
  .resaltar-coral{
    color: var(--color-coral)
  }
</style>
