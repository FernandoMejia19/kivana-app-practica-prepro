{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@componentes/*": ["src/componentes/*"],
      "@plantillas/*": ["src/plantillas/*"],
      "@datos/*": ["src/datos/*"],
      "@estilos/*": ["src/estilos/*"],
      "@assets/*": ["src/assets/*"]
    }
  }
}
