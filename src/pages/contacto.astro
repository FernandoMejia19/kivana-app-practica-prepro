---
import PlantillaBase from '@plantillas/PlantillaBase.astro';
import CampoFormulario from '@componentes/ui/CampoFormulario.astro';
import Boton from '@componentes/comunes/Boton.astro';
import { Image } from 'astro:assets';

import contactoImg from '@assets/images/Contactos/hero.webp';

const resolverRuta = (path: string) => {
  if (path.startsWith('http') || path.startsWith('#') || path.startsWith('mailto:')) return path;
  const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
  const cleanPath = path.startsWith('/') ? path.slice(1) : path;
  return `${baseUrl}${cleanPath}`;
};
---

<PlantillaBase 
  titulo="Contacto"
  descripcion="¿Tienes una pregunta sobre Kivana? Ponte en contacto con nosotros y te responderemos lo antes posible."
  rutaActual="/contacto"
>
  <!-- HERO -->
  <section class="seccion hero-contacto">
    <div class="contenedor grid-dos-columnas">
      <div class="bloque-texto">
        <h2 class="hero__titulo">Estamos para ayudarte</h2>
        <p class="hero__descripcion">
          ¿Tienes alguna pregunta sobre Kivana o sobre Kidos? Envíanos un mensaje y te responderemos tan pronto como sea posible.
        </p>
      </div>
      <div class="bloque-visual">
        <Image 
          src={contactoImg} 
          alt="Dinosaurio con sobre de mensaje para contacto" 
          class="bloque-visual__imagen"
          width={450}
          height={450}
          loading="eager"
        />
      </div>
    </div>
  </section>
  <section class="seccion seccion--blanca">
    <div class="contenedor">
      <h2 class="hero-titulo">Implementar Formulario</h2>
    </div>
  </section>
  <!-- FORMULARIO & OTROS MEDIOS DE CONTACTO
  <section class="seccion seccion--blanca">
    <div class="contenedor grid-contacto">
      <.!-- COLUMNA 1: FORMULARIO --.>
      <div class="contacto-formulario-wrapper">
        <h2 class="contacto-subtitulo">Envíanos un mensaje</h2>
        <form 
        id="formulario-contacto" 
        action="https://formspree.io/f/fercholkm19@gmail.com" 
        method="POST" 
        class="formulario"
        novalidate
        >
        <CampoFormulario 
        id="nombre" 
        etiqueta="Nombre" 
        tipo="text" 
        placeholder="Tu nombre" 
        requerido={true} 
        />
        
        <CampoFormulario 
            id="email" 
            etiqueta="Correo electrónico" 
            tipo="email" 
            placeholder="correo@ejemplo.com" 
            requerido={true} 
            />
            
            <CampoFormulario 
            id="asunto" 
            etiqueta="Asunto" 
            tipo="text" 
            placeholder="¿Sobre qué quieres hablar?" 
            requerido={true} 
            />
            
            <CampoFormulario 
            id="mensaje" 
            etiqueta="Mensaje" 
            tipo="textarea" 
            placeholder="Cuéntanos cómo podemos ayudarte..." 
            requerido={true} 
            filas={5}
            />
            
            <div class="formulario__estado" id="mensaje-estado" aria-live="polite"></div>
            
            <div class="formulario__boton-wrapper">
              <Boton tipo="submit" variante="azul" id="boton-enviar" clase="boton-pildora">
                Enviar mensaje
              </Boton>
            </div>
          </form>
        </div>
        
        <.!-- COLUMNA 2: OTROS MEDIOS DE CONTACTO --.>
        <div class="contacto-medios">
          <div class="medios-encabezado">
            <div class="medios-encabezado__texto">
              <h2 class="contacto-subtitulo">Otros medios de contacto</h2>
            <p class="contacto-medios__descripcion">
              También puedes consultar nuestras preguntas frecuentes o seguirnos en redes sociales oficiales.
            </p>
          </div>
        </div>
        
        <div class="tarjetas-medios">
          <a href={resolverRuta('/faq')} class="tarjeta-medio">
            <div class="tarjeta-medio__icono" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#69B3A5" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
              </svg>
            </div>
            <div class="tarjeta-medio__info">
              <h3>Preguntas Frecuentes</h3>
              <p>Resolvemos dudas sobre producto y Kidos</p>
            </div>
          </a>
          
          <a href="mailto:fercholkm19@gmail.com" class="tarjeta-medio">
            <div class="tarjeta-medio__icono" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#E98A76" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="4"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
            </div>
            <div class="tarjeta-medio__info">
              <h3>Soporte por Correo</h3>
              <p>fercholkm19@gmail.com</p>
            </div>
          </a>
          
          <a href="https://instagram.com/kivana_app" target="_blank" rel="noopener noreferrer" class="tarjeta-medio">
            <div class="tarjeta-medio__icono" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#69B3A5" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
            </div>
            <div class="tarjeta-medio__info">
              <h3>Instagram</h3>
              <p>@kivana_app</p>
            </div>
          </a>
          
          <a href="https://tiktok.com/@kivana_app" target="_blank" rel="noopener noreferrer" class="tarjeta-medio">
            <div class="tarjeta-medio__icono" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#E98A76" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path>
              </svg>
            </div>
            <div class="tarjeta-medio__info">
              <h3>TikTok</h3>
              <p>@kivana_app</p>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>
-->
</PlantillaBase>

<style>
  .hero-contacto {
    background-color: rgba(var(--color-menta-rgb), 0.08);
  }

  .hero__titulo {
    margin-bottom: 1.5rem;
  }

  .hero__descripcion {
    font-size: 1.15rem;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .badge-contacto {
    display: inline-block;
    font-family: var(--font-cuerpo);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-azul);
    background-color: var(--color-amarillo);
    padding: 0.35rem 1rem;
    border-radius: var(--radius-full);
    margin-bottom: 1.25rem;
  }

  .grid-dos-columnas {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .grid-dos-columnas {
      grid-template-columns: 1fr 1fr;
    }
  }

  .bloque-visual__imagen {
    width: 100%;
    max-width: 440px;
    height: auto;
    margin-left: auto;
    margin-right: auto;
  }

  .seccion--blanca {
    background-color: #FFFFFF;
  }

  .grid-contacto {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
  }

  @media (min-width: 1024px) {
    .grid-contacto {
      grid-template-columns: 1.25fr 0.75fr;
      align-items: start;
    }
  }

  .contacto-subtitulo {
    font-size: 1.65rem;
    font-family: var(--fuente-titulos);
    font-weight: 600;
    color: #123B56;
    margin-bottom: 1.25rem;
    line-height: 1.3;
  }
  .seccion--menta{
    background-color: var(--color-azul);
  }
  .contacto-formulario-wrapper {
    background-color: var(--color-crema);
    padding: 2.5rem;
    border-radius: 26px;
    box-shadow: 0 10px 30px rgba(18, 59, 86, 0.05);
    border: 1px solid rgba(18, 59, 86, 0.04);
  }

  @media (max-width: 640px) {
    .contacto-formulario-wrapper {
      padding: 1.75rem 1.25rem;
    }
  }

  .formulario__boton-wrapper {
    margin-top: 1.5rem;
  }

  .boton-pildora {
    border-radius: 999px !important;
    padding: 0.9rem 2.25rem !important;
    font-size: 1rem !important;
  }

  .formulario__estado {
    margin-top: 1rem;
    margin-bottom: 1rem;
    font-family: var(--fuente-cuerpo);
    font-weight: 700;
    border-radius: 12px;
    padding: 0.75rem 1rem;
    display: none;
  }

  .formulario__estado--exito {
    display: block;
    background-color: rgba(105, 179, 165, 0.15);
    color: #4C8E7E;
    border: 1px solid #69B3A5;
  }

  .formulario__estado--error {
    display: block;
    background-color: rgba(233, 138, 118, 0.15);
    color: #D87763;
    border: 1px solid #E98A76;
  }

  /* Columna Derecha Medios de Contacto */
  .medios-encabezado {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .medios-encabezado__texto {
    flex: 1;
  }

  .medios-encabezado__mascota {
    flex-shrink: 0;
  }

  .mascota-sutil-img {
    width: 68px;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 4px 10px rgba(18, 59, 86, 0.08));
  }

  .contacto-medios__descripcion {
    font-size: 1.05rem;
    line-height: 1.5;
    color: #123B56;
    opacity: 0.85;
    margin-bottom: 0;
  }

  .tarjetas-medios {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .tarjeta-medio {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    background-color: #FFF9F0;
    padding: 1.25rem 1.5rem;
    border-radius: 18px;
    box-shadow: 0 6px 18px rgba(18, 59, 86, 0.04);
    border: 1px solid rgba(18, 59, 86, 0.03);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    text-decoration: none;
  }

  .tarjeta-medio:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(18, 59, 86, 0.08);
  }

  .tarjeta-medio__icono {
    width: 48px;
    height: 48px;
    min-width: 48px;
    background-color: #FFFFFF;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px rgba(18, 59, 86, 0.06);
  }

  .tarjeta-medio__info h3 {
    font-size: 1.1rem;
    font-family: var(--fuente-titulos);
    font-weight: 600;
    color: #123B56;
    margin-bottom: 0.2rem;
  }

  .tarjeta-medio__info p {
    font-size: 0.9rem;
    color: #123B56;
    opacity: 0.75;
    margin: 0;
  }

  @media (max-width: 767px) {
    .hero-contacto .bloque-texto,
    .bloque-texto {
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
  }
</style>

<script>
  const form = document.getElementById('formulario-contacto') as HTMLFormElement | null;
  const estadoDiv = document.getElementById('mensaje-estado');
  const submitBtn = document.getElementById('boton-enviar') as HTMLButtonElement | null;

  if (form && estadoDiv && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      // Limpiar estados previos
      estadoDiv.className = 'formulario__estado';
      estadoDiv.style.display = 'none';
      
      // Validar inputs
      let esValido = true;
      const campos = ['nombre', 'email', 'asunto', 'mensaje'];

      campos.forEach(id => {
        const input = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null;
        const parent = input?.closest('.formulario__campo');
        const errorSpan = document.getElementById(`${id}-error`);

        if (input && parent && errorSpan) {
          if (!input.value.trim()) {
            esValido = false;
            parent.classList.add('formulario__campo--invalido');
            errorSpan.textContent = 'Este campo es obligatorio.';
          } else if (id === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(input.value.trim())) {
            esValido = false;
            parent.classList.add('formulario__campo--invalido');
            errorSpan.textContent = 'Introduce un correo electrónico válido.';
          } else {
            parent.classList.remove('formulario__campo--invalido');
            errorSpan.textContent = '';
          }
        }
      });

      if (!esValido) return;

      // Estado Enviando
      submitBtn.disabled = true;
      const textoOriginal = submitBtn.textContent;
      submitBtn.textContent = 'Enviando...';

      try {
        const formData = new FormData(form);
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/json'
          }
        });

        if (response.ok) {
          estadoDiv.className = 'formulario__estado formulario__estado--exito';
          estadoDiv.textContent = '✓ Mensaje enviado correctamente. Te responderemos tan pronto como sea posible.';
          form.reset();
        } else {
          throw new Error('Error al enviar el formulario.');
        }
      } catch (err) {
        estadoDiv.className = 'formulario__estado formulario__estado--error';
        estadoDiv.textContent = 'No fue posible enviar el mensaje. Por favor inténtalo nuevamente.';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = textoOriginal;
      }
    });
  }
</script>
