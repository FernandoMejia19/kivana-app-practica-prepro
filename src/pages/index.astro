---
import PlantillaBase from '@plantillas/PlantillaBase.astro';
import Boton from '@componentes/comunes/Boton.astro';
import { Image } from 'astro:assets';

// Importación de Assets
import heroMockup from '@assets/images/Home/Home-hero2.webp';
import problemaImg from '@assets/images/Home/Home-problema.webp';
import solucionImg from '@assets/images/Home/Home-soluciom.webp';
import organizarcioImg from '@assets/images/Home/Home-kidos.webp';
import recuerdosImg from '@assets/images/Nosotros/familia.webp';
import inicioAppImg from '@assets/images/Home/Home-hero.webp';
import actividadCompleta from '@assets/images/Home/Home-actividad-completa.webp'
import actividadVerificaion from '@assets/images/Home/Home-actividad-verificacion.webp'
import actividadRecompensa from '@assets/images/Home/Home-actividad-recompensa.webp'
import acompanamientoImg from '@assets/images/Home/Home-dino-amarillo.webp'
import mockupAplicacion from '@assets/images/celular-mockup.png'
---

<PlantillaBase 
  titulo="Inicio - La vida familiar, más organizada y divertida"
  descripcion="Kivana es la aplicación familiar para organizar eventos, tareas, miembros y recuerdos en un solo lugar, con una experiencia de hábitos y recompensas para niños mediante Kidos."
  rutaActual="/"
>
  <!-- 1. HERO SECTION -->
  <section class="hero seccion">
    <div class="contenedor hero__contenedor">
      <div class="hero__contenido">
        <h1 class="hero__titulo">La vida familiar, más organizada y divertida.</h1>
        <p class="hero__descripcion">
          Cada tarea, cada plan y cada pequeño logro pueden convertirse en una experiencia para toda la familia.
        </p>
        <div class="hero__acciones">
          <Boton href="/funcionalidades" variante="kidos">
            Conoce Kivana
          </Boton>
        </div>
        <!----
        <div class="hero__tiendas">
          <span class="hero__tiendas-texto">Próximamente disponible en tiendas oficiales</span>
        </div>
        -->
      </div>
      <div class="hero__visual">
        <Image 
          src={heroMockup} 
          alt="Vista previa de Kivana en smartphone con dinosaurios felices" 
          class="hero__imagen"
          width={540}
          height={540}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- 2. PROBLEMA COTIDIANO -->
  <section class="seccion seccion--crema-oscura">
    <div class="contenedor grid-dos-columnas grid-dos-columnas--reverso">
      <div class="bloque-texto">
        <h2 class="bloque-texto__titulo">En casa, todos tienen algo que hacer.</h2>
        <p class="bloque-texto__descripcion">
          La vida familiar tiene muchas cosas pasando al mismo tiempo. Kivana pone orden al día a día.
        </p>
      </div>
      <div class="bloque-visual">
        <Image 
          src={problemaImg} 
          alt="Ilustración de la vida familiar con múltiples actividades simultáneas" 
          class="bloque-visual__imagen"
          width={480}
          height={480}
          loading="lazy"
        />
      </div>
    </div>
  </section>


  <!-- 4. ORGANIZACIÓN FAMILIAR -->
  <section class="seccion seccion--blanca">
    <div class="contenedor grid-dos-columnas">
      <div class="bloque-texto">
        <h2 class="bloque-texto__titulo"> <span class="resaltar-azul">Kivana</span> pone orden al día a día.</h2>
        <p class="bloque-texto__descripcion">
          Kivana ayuda a que cada miembro de la familia sepa qué toca hoy y qué viene después.
        </p>
        <ul class="lista-beneficios">
          <li class="lista-beneficios__item">✓ Calendario familiar</li>
          <li class="lista-beneficios__item">✓ Tareas compartidas</li>
          <li class="lista-beneficios__item">✓ Familia privada</li>
        </ul>
      </div>
      <div class="bloque-visual">
        <Image 
          src={solucionImg} 
          alt="Pantalla de organización diaria en Kivana" 
          class="bloque-visual__imagen"
          width={480}
          height={480}
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- 5. TRANSICIÓN KIDOS & 6. KIDOS -->
  <section class="seccion seccion--amarillo">
    <div class="contenedor texto-centrado grid-dos-columnas">
      <div class="kidos-flujo-contenedor">
        <Image 
          src={organizarcioImg} 
          alt="Flujo Kidos: Actividad completada -> Validación del padre -> Puntos y recompensas" 
          class="kidos-flujo-imagen"
          width={1000}
          height={400}
          loading="lazy"
        />
      </div>
      <div>
      <h2 class="seccion__titulo">Organizarse también puede ser una aventura.</h2>
      <p class="seccion__subtitulo">
        Con Kidos, las actividades cotidianas se convierten en progreso, huevos y recompensas que motivan a los niños mientras los padres acompañan cada paso.
      </p>
      <div class="espacio-superior-lg">
        <Boton href="/kidos" variante="primario">
          Descubre cómo funciona Kidos
        </Boton>
      </div>
      
      </div>
      
      

    </div>
  </section>

  <!---Funcionamiento Kidos -->
  <section class="seccion seccion--amarillo">
    <div class="contenedor texto-centrado">
      <div class="pasos-grid">
        <article class="pasos-card">
          <Image src={actividadCompleta} alt="Actividad Completada" class="pasos-card__imagen" width={320} height={320} loading="lazy" />
          <h3 class="pasos-card__titulo">Actividad Completada</h3>
        </article>
        <article class="pasos-card">
          <Image src={actividadVerificaion} alt="Validación del padre" class="pasos-card__imagen" width={320} height={320} loading="lazy" />
          <h3 class="pasos-card__titulo">Validacion del padre.</h3>
        </article>
        <article class="pasos-card">
          <Image src={actividadRecompensa} alt="Puntos y recompensas" class="pasos-card__imagen" width={320} height={320} loading="lazy" />
          <h3 class="pasos-card__titulo">Puntos y recompensas.</h3>
        </article>
      </div>
    </div>
  </section>

  <!-- 7. ACOMPAÑAMIENTO PARENTAL -->
  <section class="seccion">
    <div class="contenedor grid-tres-tarjetas">
      <div class="bloque-visual">
        <Image 
          src={mockupAplicacion} 
          alt="Mockup de aplicación Kivana." 
          class="bloque-visual__imagen"
          width={480}
          height={480}
          loading="lazy"
        />
      </div>
      <div class="bloque-texto centrar-vertical">
        <h2 class="bloque-texto__titulo">Ellos participan. <br><span class="resaltar-coral"> Tú acompañas. </span></h2>
        <p class="bloque-texto__descripcion">
          Los niños avanzan en sus actividades y los padres validan sus logros antes de continuar su aventura.
        </p>
      </div>
      <div class="bloque-visual alinear-abajo">
        <Image 
          src={acompanamientoImg} 
          alt="Participación y recompensa." 
          class="bloque-visual__imagen"
          width={480}
          height={480}
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- 8. RECUERDOS -->
  <section class="seccion seccion--blanca">
    <div class="contenedor grid-dos-columnas">
      <div class="bloque-texto">
        <h2 class="bloque-texto__titulo">Hay momentos que merecen quedarse.</h2>
        <p class="bloque-texto__descripcion">
          Kivana no solo ayuda a organizar lo que viene. También permite guardar lo que ya vivieron juntos con fotos, comentarios y galería familiar.
        </p>
      </div>
      <div class="bloque-visual">
        <Image 
          src={recuerdosImg} 
          alt="Familia de dinosaurios compartiendo un álbum de recuerdos" 
          class="bloque-visual__imagen"
          width={480}
          height={480}
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- 9. FAMILIA PRIVADA 
  <section class="seccion">
    <div class="contenedor grid-dos-columnas grid-dos-columnas--reverso">
      <div class="bloque-texto">
        <h2 class="bloque-texto__titulo">Tu familia. Tu espacio.</h2>
        <p class="bloque-texto__descripcion">
          Crea tu grupo familiar, invita mediante un código y decide quién puede formar parte de él.
        </p>
      </div>
      <div class="bloque-visual">
        <Image 
        src={familiaPrivadaImg} 
        alt="Integración familiar y espacio privado" 
        class="bloque-visual__imagen"
        width={480}
        height={480}
        loading="lazy"
        />
      </div>
    </div>
  </section>
  -->

  <!-- 10. UN VISTAZO A KIVANA -->
  <section class="seccion seccion--crema-oscura">
    <div class="contenedor texto-centrado">
      <h2 class="seccion__titulo">Un vistazo a Kivana</h2>
      <p class="seccion__subtitulo">Una interfaz limpia, cálida y pensada para la vida diaria del hogar.</p>
      <div class="galeria-grid">
        <article class="galeria-card">
          <Image src={inicioAppImg} alt="Pantalla de Inicio" class="galeria-card__imagen" width={320} height={320} loading="lazy" />
          <h3 class="galeria-card__titulo">Captura 1</h3>
        </article>
        <article class="galeria-card">
          <Image src={inicioAppImg} alt="Calendario de Eventos" class="galeria-card__imagen" width={320} height={320} loading="lazy" />
          <h3 class="galeria-card__titulo">Captura 2</h3>
        </article>
        <article class="galeria-card">
          <Image src={inicioAppImg} alt="Tareas y Actividades" class="galeria-card__imagen" width={320} height={320} loading="lazy" />
          <h3 class="galeria-card__titulo">Captura 3</h3>
        </article>
      </div>
    </div>
  </section>

  <!-- 11. CTA FINAL -->
  <section class="seccion cta-final">
    <div class="contenedor cta-final__contenedor">
      <h2 class="cta-final__titulo">Organiza lo que importa.</h2>
      <p class="cta-final__descripcion">
        Conecta a tu familia con una experiencia simple y organizada.
      </p>
      <div class="cta-final__acciones">
        <Boton href="/contacto" variante="menta">
          Conoce Kivana
        </Boton>
        <Boton href="/funcionalidades" variante="crema">
          Ver funcionalidades
        </Boton>
      </div>
    </div>
  </section>
</PlantillaBase>

<style>
  .hero {
    padding-top: var(--espacio-lg);
    padding-bottom: var(--espacio-xl);
  }

  .hero__contenedor {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero__contenedor {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .hero__badge {
    display: inline-block;
    font-family: var(--fuente-cuerpo);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-azul);
    background-color: var(--color-amarillo);
    padding: 0.35rem 1rem;
    border-radius: var(--radio-completo);
    margin-bottom: 1.25rem;
  }

  .hero__titulo {
    margin-bottom: 1.25rem;
  }

  .hero__descripcion {
    font-size: 1.2rem;
    margin-bottom: 2rem;
    max-width: 560px;
  }

  .hero__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .hero__tiendas-texto {
    font-size: 0.9rem;
    color: rgba(var(--color-azul-rgb), 0.65);
    font-weight: 600;
  }

  .hero__imagen {
    width: 100%;
    max-width: 520px;
    height: auto;
    margin-left: auto;
    margin-right: auto;
  }
@media(max-width: 1024px){
  .hero__descripcion{
    text-align: center;
  }
  .hero__titulo{
    text-align: center;
  }
  .hero__acciones{
    justify-content: center;
  }
}
  /* Diseños de Grid */
  .grid-dos-columnas {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .grid-dos-columnas {
      grid-template-columns: 1fr 1fr;
    }

    .grid-dos-columnas--reverso {
      grid-template-columns: 1fr 1fr;
    }

    .grid-dos-columnas--reverso .bloque-texto {
      order: 2;
    }

    .grid-dos-columnas--reverso .bloque-visual {
      order: 1;
    }
  }

  .bloque-texto__titulo {
    margin-bottom: 1rem;
  }

  .bloque-texto__descripcion {
    font-size: 1.1rem;
    margin-bottom: 1.5rem;
  }

  .bloque-visual__imagen {
    width: 100%;
    max-width: 460px;
    height: auto;
    margin-left: auto;
    margin-right: auto;
  }
  @media(max-width: 1024px) {
    .bloque-texto{
      text-align: center;
    }
  }
  .seccion--crema-oscura {
    background-color: rgba(var(--color-amarillo-rgb), 0.12);
  }

  .seccion--blanca {
    background-color: var(--color-blanco);
  }
  .seccion--amarillo{
    background-color: var(--color-amarillo);
  }
  .seccion--kidos {
    background-color: rgba(var(--color-menta-rgb), 0.1);
  }

  .seccion__titulo {
    margin-bottom: 1rem;
    color: var(--color-azul);
  }

  .seccion__subtitulo {
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 2.5rem;
    font-size: 1.15rem;
  }

  /* Tarjetas 3 Pilares */
  .grid-tres-tarjetas {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-top: 2.5rem;
  }

  @media (min-width: 768px) {
    .grid-tres-tarjetas {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .tarjeta {
    background-color: var(--color-blanco);
    padding: 2.25rem 1.5rem;
    border-radius: var(--radio-lg);
    box-shadow: var(--sombra-suave);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    text-align: center;
    border: 1px solid rgba(var(--color-azul-rgb), 0.05);
  }

  .tarjeta:hover {
    transform: translateY(-6px);
    box-shadow: var(--sombra-media);
  }

  .tarjeta__icono-contenedor {
    margin-bottom: 1.25rem;
    display: flex;
    justify-content: center;
  }

  .tarjeta__icono {
    width: 90px;
    height: auto;
  }

  .tarjeta__titulo {
    margin-bottom: 0.75rem;
  }

  .tarjeta__descripcion {
    font-size: 0.95rem;
  }

  /* Lista de Beneficios */
  .lista-beneficios {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .lista-beneficios__item {
    font-family: var(--fuente-cuerpo);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-menta);
  }

  /* Kidos Flujo */
  .badge-ludico {
    display: inline-block;
    font-family: var(--fuente-cuerpo);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-azul);
    background-color: var(--color-menta);
    padding: 0.35rem 1rem;
    border-radius: var(--radio-completo);
    margin-bottom: 1rem;
  }

  .kidos-flujo-imagen {
    width: 100%;
    max-width: 960px;
    height: auto;
    margin-left: auto;
    margin-right: auto;
  }

  .espacio-superior-lg {
    margin-top: 2rem;
  }
/*Pasos Kivana */
  .pasos-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 768px) {
    .pasos-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .pasos-card {
  }

  .pasos-card:hover {
    transform: translateY(-4px);
  }

  .pasos-card__imagen {
    width: 100%;
    height: auto;
    border-radius: var(--radio-sm);
    margin-bottom: 1rem;
  }

  .pasos-card__titulo {
    font-size: 1.2rem;
    color: var(--color-azul);
    padding: 0.85rem 0.85rem;
    background-color: var(--color-crema);
    border-radius: var(--radio-md);
    border-color: var(--color-menta);
  }

  /* Galería */
  .galeria-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .galeria-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .galeria-card {
    background-color: var(--color-blanco);
    padding: 1.5rem;
    border-radius: var(--radio-md);
    box-shadow: var(--sombra-suave);
    transition: transform 0.25s ease;
  }

  .galeria-card:hover {
    transform: translateY(-4px);
  }

  .galeria-card__imagen {
    width: 100%;
    height: auto;
    border-radius: var(--radio-sm);
    margin-bottom: 1rem;
  }

  .galeria-card__titulo {
    font-size: 1.2rem;
  }

  /* CTA Final */
  .cta-final {
    background-color: #FFD27A;
    color: #123B56;
    text-align: center;
    border-radius: var(--radio-lg);
    margin: 3rem 1.5rem;
  }

  .cta-final__titulo {
    color: #123B56;
    margin-bottom: 1rem;
  }

  .cta-final__descripcion {
    color: #123B56;
    font-size: 1.2rem;
    max-width: 540px;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 2rem;
  }

  .cta-final__acciones {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .centrar-vertical{
    display: flex;
    flex-direction: column;
    text-align: center;
    justify-content: center;
  }
  .alinear-abajo {
    display: flex;
    flex-direction: column-reverse;
  }
  .resaltar-coral{
    color: var(--color-coral);
  }
  .resaltar-azul{
    color: var(--color-azul);
  }
</style>
